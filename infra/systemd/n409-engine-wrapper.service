# /etc/systemd/system/n409-engine-wrapper.service
# Internal calculation engine (port 3003, FastAPI/uvicorn from its own venv).
# SECURITY (audit B-1 P0): binds 127.0.0.1 (never world-reachable) and requires
# X-Internal-Token (INTERNAL_SERVICE_TOKEN in /opt/N409/.env). The CPU-bound
# /engine/v1/compute is a DoS target if exposed. See infra/DEPLOYMENT.md.
# APP_ENV=production is what makes that token mandatory rather than advisory:
# without it the service starts and serves unauthenticated when the secret is
# missing, which is the failure the guard exists to prevent.
[Unit]
Description=N409 engine-wrapper (FastAPI calculation engine)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/N409/src/services/engine-wrapper
EnvironmentFile=/opt/N409/.env
Environment=APP_ENV=production
ExecStart=/opt/N409/src/services/engine-wrapper/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 3003 --timeout-graceful-shutdown 15
Restart=always
RestartSec=3
# ── Shutdown deadline (round 158) ────────────────────────────────────────────
# Paired with --timeout-graceful-shutdown on ExecStart above, which is the half
# that was missing. uvicorn's graceful shutdown is unbounded by default: on
# SIGTERM it waits for in-flight requests with no deadline, and the OPM/waterfall
# compute holds a worker thread for the whole of a run.
# So the process never exited on its own, systemd waited out its 90s default and
# SIGKILLed — mid-flight, which is precisely the outcome the graceful path
# exists to avoid. The three Node services have been bounded at 10s since they
# gained shared/shutdown.ts; this is that same contract, finally symmetric.
#
# 30s leaves uvicorn its 15s and a margin. Past that the process is wedged, and
# deploy.sh is waiting on this restart.
TimeoutStopSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# ── Memory (round 99) ────────────────────────────────────────────────────────
# 49MB resident, 50MB peak. Flat at rest and the one unit whose cost is a
# function of its *input* rather than its concurrency: /engine/v1/compute walks
# a cap table, and a pathological one allocates. The body caps in
# `app/config.py` are the real defence; this is the backstop for a shape they
# admit and the allocator does not like.
MemoryAccounting=yes
MemoryHigh=192M
MemoryMax=256M
MemorySwapMax=64M
# Non-root service user (audit P1-1). Create on the host first:
#   useradd --system --home /opt/N409 --shell /usr/sbin/nologin n409
User=n409
Group=n409

[Install]
WantedBy=multi-user.target
