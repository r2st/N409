# /etc/systemd/system/n409-report.service
# Internal report-rendering service (port 3004). Never public — it binds
# loopback, the firewall blocks 3004 from the internet, and /render requires
# X-Internal-Token (INTERNAL_SERVICE_TOKEN, already in the EnvironmentFile
# below) exactly as the ai and engine-wrapper units do. See infra/DEPLOYMENT.md.
[Unit]
Description=N409 report service (TS/Fastify)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/N409/src/services/report
EnvironmentFile=/opt/N409/.env
Environment=NODE_ENV=production
Environment=PORT=3004
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=3
# ── Shutdown deadline (round 158) ────────────────────────────────────────────
# Pinned rather than inherited. shared/shutdown.ts runs the graceful path under
# a 10s deadline and exits either way, and its whole justification is that 10s
# is "comfortably under systemd's 90s TimeoutStopSec" — a claim about a distro
# *default*, which is not a thing this repository controls. Stated here, the
# relationship between the two numbers is a fact of the deploy rather than a
# coincidence, and it survives a host whose default is something else.
#
# 30s, not 90s: the app gives up at 10s, so anything past that is the process
# failing to exit at all, and deploy.sh waits on this restart. Waiting a further
# 80s to SIGKILL something already known to be wedged only makes the deploy look
# hung — the one symptom the bounded shutdown existed to remove.
TimeoutStopSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# ── Memory (round 99) ────────────────────────────────────────────────────────
# The unit this estate actually needed a limit for. Round 98 moved PDF rendering
# here off the API's event loop, and in doing so removed the bound nobody had
# designed: pdfkit is synchronous, so in-process renders were strictly serial
# and one render's working set was the whole cost however many clients asked.
# Delegating makes them concurrent. `MAX_DELEGATED_IN_FLIGHT` (4) +
# `MAX_DELEGATED_QUEUED` (12) is 16 renders that can be resident here at once,
# measured at ~10MB of retained working set each on top of a 116MB idle process
# — 326MB at 12 concurrent, 407MB at 24. So the designed ceiling is ~280MB and
# 512M is that plus room for GC lag and heap fragmentation.
#
# `src/services/valuation/src/preflight.ts` recomputes that floor from the two
# constants at deploy time: raise the queue depth without raising this number
# and the deploy fails rather than the host.
MemoryAccounting=yes
MemoryHigh=384M
MemoryMax=512M
MemorySwapMax=128M
# Non-root service user (audit P1-1). Create on the host first:
#   useradd --system --home /opt/N409 --shell /usr/sbin/nologin n409
User=n409
Group=n409

[Install]
WantedBy=multi-user.target
