# /etc/systemd/system/n409-web.service
# The web/BFF: serves the built SPA and proxies /api/* to the valuation service
# (port 3000). This is the only app port Caddy fronts (n409.aiknol.com → :3000).
# See infra/DEPLOYMENT.md.
[Unit]
Description=N409 web/BFF (SPA host + /api proxy)
After=network-online.target n409-valuation.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/N409/src/services/web
EnvironmentFile=/opt/N409/.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=VALUATION_URL=http://127.0.0.1:3001
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=3
# ── Shutdown deadline (round 158) ────────────────────────────────────────────
# Pinned rather than inherited. shared/shutdown.ts runs the graceful path under
# a 10s deadline and exits either way, and its whole justification is that 10s
# is "comfortably under systemd's 90s TimeoutStopSec" — a claim about a distro
# *default*, which is not a thing this repository controls. Stated here, the
# relationship between the two numbers is a fact of the deploy rather than a
# coincidence, and it survives a host whose default is something else.
#
# 30s, not 90s: the app gives up at 10s, so anything past that is the process
# failing to exit at all, and deploy.sh waits on this restart. Waiting a further
# 80s to SIGKILL something already known to be wedged only makes the deploy look
# hung — the one symptom the bounded shutdown existed to remove.
TimeoutStopSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# ── Memory (round 99) ────────────────────────────────────────────────────────
# 57MB resident, 78MB peak. It serves static SPA assets and proxies /api, and
# neither cost scales with anything but concurrency. The smallest ceiling in the
# estate, which is also the point: this is the only unit Caddy dials, so it is
# the one whose death is the whole site, and a bound this far above its measured
# working set only fires on something genuinely wrong.
MemoryAccounting=yes
MemoryHigh=144M
MemoryMax=192M
MemorySwapMax=48M
# Non-root service user (audit P1-1). Create on the host first:
#   useradd --system --home /opt/N409 --shell /usr/sbin/nologin n409
User=n409
Group=n409

[Install]
WantedBy=multi-user.target
