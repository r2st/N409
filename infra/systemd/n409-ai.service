# /etc/systemd/system/n409-ai.service
# Internal AI pipeline service (port 3002, FastAPI/uvicorn from its own venv).
# SECURITY (audit B-1 P0): binds 127.0.0.1 so the port is never world-reachable,
# and requires X-Internal-Token (INTERNAL_SERVICE_TOKEN in /opt/N409/.env). The
# host firewall (infra/firewall/) is the belt to this braces. APP_ENV=production
# forces PII redaction on (options.anonymize=false is ignored). See DEPLOYMENT.md.
[Unit]
Description=N409 AI service (FastAPI, OpenRouter pipelines)
After=network-online.target n409-engine-wrapper.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/N409/src/services/ai
EnvironmentFile=/opt/N409/.env
Environment=APP_ENV=production
Environment=ENGINE_URL=http://127.0.0.1:3003
ExecStart=/opt/N409/src/services/ai/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 3002 --timeout-graceful-shutdown 15
Restart=always
RestartSec=3
# ── Shutdown deadline (round 158) ────────────────────────────────────────────
# Paired with --timeout-graceful-shutdown on ExecStart above, which is the half
# that was missing. uvicorn's graceful shutdown is unbounded by default: on
# SIGTERM it waits for in-flight requests with no deadline, and every pipeline here blocks
# on an LLM for up to 90 seconds.
# So the process never exited on its own, systemd waited out its 90s default and
# SIGKILLed — mid-flight, which is precisely the outcome the graceful path
# exists to avoid. The three Node services have been bounded at 10s since they
# gained shared/shutdown.ts; this is that same contract, finally symmetric.
#
# 30s leaves uvicorn its 15s and a margin. Past that the process is wedged, and
# deploy.sh is waiting on this restart.
TimeoutStopSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# ── Memory (round 99) ────────────────────────────────────────────────────────
# 61MB resident, 62MB peak — flat, because the pipelines stream OpenRouter
# responses rather than accumulating them. Sized at 4x the observed working set
# so the limit is a runaway detector rather than a capacity plan.
MemoryAccounting=yes
MemoryHigh=192M
MemoryMax=256M
MemorySwapMax=64M
# Non-root service user (audit P1-1). Create on the host first:
#   useradd --system --home /opt/N409 --shell /usr/sbin/nologin n409
User=n409
Group=n409

[Install]
WantedBy=multi-user.target
