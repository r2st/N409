# /etc/systemd/system/n409-backup-verify.service
# Weekly restore test. Oneshot unit invoked by n409-backup-verify.timer. Runs
# pg-verify.sh, which restores the newest dump into a scratch database, asks it
# whether the schema and the spine tables actually came back, and drops it.
#
# This is the unit that turns "we take backups" into "we have restored one this
# week". pg-backup.sh proves an archive is well-formed; only a restore proves it
# is a backup. See infra/backup/README.md.
[Unit]
Description=N409 backup verification (restore the newest dump into a scratch DB)
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=oneshot
User=n409
Group=n409
EnvironmentFile=/opt/N409/.env
# Second, and it must stay second: it overrides the DATABASE_URL the line above
# sets, and systemd applies these in the order they appear.
#
# The restore creates a scratch database, which needs CREATE DATABASE. The
# application role does not have that privilege and is not going to get it — it
# is the credential the internet-facing service holds, and widening it so a
# weekly maintenance job can run is the wrong trade in the wrong direction. So
# the verification connects as `n409_verify`, which has LOGIN and CREATEDB and
# nothing else: no ownership of any application object and no grants on the
# application database. `pg_restore --no-owner --no-acl` means it never needs
# any. Restoring with a credential that is not the application's is also closer
# to the situation this job exists to rehearse.
#
# Not prefixed with `-`: a host where this file is missing would otherwise fall
# through to the application's DATABASE_URL and fail every Sunday with
# `permission denied to create database`, which reads like a broken backup
# rather than a missing credential. A hard failure to start names the cause.
#
# Provisioned by hand, outside the repository, because it holds a password. See
# infra/backup/README.md.
EnvironmentFile=/etc/n409/backup-verify.env
Environment=BACKUP_ROOT=/opt/n409-backups
# Where this run's outcome is stamped for the valuation service to read
# (R437) — must match BACKUP_VERIFY_STATE_DIR in /opt/N409/.env.
# `StateDirectory=` creates it (owned by this unit's User=/Group=) and adds it
# to the write paths ProtectSystem=strict below otherwise removes; it is the
# one directory this unit may write to that is not the private, torn-down-on-
# exit /tmp PrivateTmp= gives it.
Environment=VERIFY_STATE_DIR=/var/lib/n409-backup-verify
StateDirectory=n409-backup-verify
ExecStart=/opt/N409/infra/backup/pg-verify.sh
# A restore of a production-sized dump is not a two-minute job, and a
# verification killed by a timeout would report as a failed verification —
# which is the one false alarm guaranteed to get this timer disabled.
TimeoutStartSec=3600
# ── Memory (round 99) ────────────────────────────────────────────────────────
# Twice the nightly backup's ceiling, for the same reason its TimeoutStartSec is
# an hour: this is the unit that restores a production-sized dump, and a
# verification killed part-way reports as a failed verification — the one false
# alarm guaranteed to get this timer switched off. `pg_restore` is as
# stream-shaped as `pg_dump` and the heavy work is again the server's, so this
# is headroom rather than a measurement.
#
# It is the largest scheduled job in the estate, which is what the deploy-time
# estate sum adds to the always-on units: 04:00 Sunday is a moment when this
# ceiling and all five services' ceilings are live at once.
MemoryAccounting=yes
MemoryHigh=384M
MemoryMax=512M
MemorySwapMax=128M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Read-only here: verification restores into a database, never into the backup
# directory. If this unit ever needs write access to /opt/n409-backups,
# something has gone wrong with what it is being asked to do.
ReadOnlyPaths=/opt/n409-backups

# No [Install] section, deliberately. This unit is started by
# n409-backup-verify.timer, which is the thing that gets enabled; a `WantedBy=`
# here would additionally make `systemctl enable n409-backup-verify.service`
# succeed and run a full restore on every boot — competing for disk and IO with
# the services coming up, for a check whose whole justification is that weekly is
# often enough. Without it that command refuses, which is the correct answer.
