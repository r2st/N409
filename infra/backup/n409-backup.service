# /etc/systemd/system/n409-backup.service
# Nightly PostgreSQL backup (audit P0-1). Oneshot unit invoked by
# n409-backup.timer. Runs pg-backup.sh, which dumps the DB, promotes a weekly
# copy on Sundays, and prunes to 7 daily + 4 weekly. See infra/backup/README.md.
[Unit]
Description=N409 PostgreSQL backup (pg_dump + rotation)
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=oneshot
# Run as the dedicated service user (created during hardening; see DEPLOYMENT.md).
User=n409
Group=n409
EnvironmentFile=/opt/N409/.env
Environment=BACKUP_ROOT=/opt/n409-backups
ExecStart=/opt/N409/infra/backup/pg-backup.sh
# The dump is the whole database in the clear. pg-backup.sh sets `umask 077`
# itself so a hand-run is protected too; this is the same bound stated where an
# operator reading the unit can see it, and it covers anything else the unit
# comes to create.
UMask=0077
# ── Memory (round 99) ────────────────────────────────────────────────────────
# `pg_dump -Fc` streams: it holds the schema, one row's worth of buffer and a
# zlib window, and the sorting and index work that could actually allocate
# happens in the PostgreSQL backend, which is in postgresql.service's cgroup and
# not this one. So the client side is small and the ceiling is generous — the
# limit exists because this unit runs at 02:00 against a live estate, not
# because anything here is expected to approach it.
#
# Deliberately *not* tight: a backup killed by a memory limit is a night with no
# backup, reported as a failed unit that reads like a broken database.
MemoryAccounting=yes
MemoryHigh=192M
MemoryMax=256M
MemorySwapMax=64M
# Hardening: the job only needs to read the app tree + write the backup root.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/n409-backups

[Install]
WantedBy=multi-user.target
