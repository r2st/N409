{
  "name": "n409",
  "private": true,
  "version": "0.1.0",
  "description": "409.ai platform rebuild — monorepo (web, valuation, ai, engine-wrapper, report)",
  "type": "module",
  "workspaces": [
    "src/packages/*",
    "src/services/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b && npm run build -w @n409/web-frontend",
    "clean": "tsc -b --clean",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --dry || tsc -b",
    "test": "npm run build && npm run test --workspaces --if-present",
    "test:unit": "npm run build && npm run test:unit --workspaces --if-present",
    "migrate": "npm run migrate -w @n409/valuation",
    "dev:db": "docker compose up -d postgres redis",
    "e2e": "npm run e2e:db && playwright test --config e2e/playwright.config.ts",
    "e2e:db": "node e2e/reset-db.mjs",
    "e2e:headed": "npm run e2e:db && playwright test --config e2e/playwright.config.ts --headed",
    "e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "e2e:report": "playwright show-report e2e/.artifacts/report",
    "sample:report": "npm run build && node tools/sample-report.mjs",
    "sample:engine": "cd src/services/engine-wrapper && .venv/bin/python -m uvicorn app.main:app --port 8799"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^14.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.67.0"
  }
}
