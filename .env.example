# This is the LOCAL template. The deployed /opt/N409/.env is not a copy of it.
#
# Two of the settings below — PORT and NODE_ENV — are set by each systemd unit
# in infra/systemd/ as well, and every unit shares this one file. Copying them
# onto the host therefore sets each variable twice with different values: PORT
# would be 3001 for all five services rather than 3000/3001/3002/3003/3004, and
# NODE_ENV would be `development` against the unit's `production`. Which value
# wins is a systemd precedence rule that is not visible from either file, so the
# honest answer is that nobody reading the host can tell whether the production
# guards are armed.
#
# `infra/deploy.sh` refuses to restart anything when the deployed file does that
# (src/services/valuation/src/preflight.ts). Set them in the unit, not here.
#
# Valuation service
DATABASE_URL=postgres://n409:n409_dev@localhost:5432/n409_dev
PORT=3001
LOG_LEVEL=info
# Which interface the three Node services bind. Loopback by default, because
# 3001–3004 carry no user-facing authentication and the host firewall should not
# be the only thing in front of them. Containers need 0.0.0.0 — Docker publishes
# a port by reaching the container's own interface, so a loopback bind inside
# one is unreachable; docker-compose sets it for that reason. A bare `HOST=` is
# read as unset rather than as every interface.
HOST=
# development | test | production. Several protections are only armed in
# production — the session and heavy-route rate limiters below are no-ops
# anywhere else — so this being wrong in prod is a security setting being off.
NODE_ENV=development

# Auth — generate a real secret: openssl rand -hex 32
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_ISSUER=n409
JWT_TTL_SECONDS=28800

# Google OIDC SSO (issue #3) — from Google Cloud console; keep real values in keys/, never commit
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback

# Observability (issue #4) — leave endpoint empty to disable OTLP export
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=valuation
# Metrics are exported alongside traces by default. Set false to keep tracing
# but stop the metric reader — the usual reason is a collector that accepts
# OTLP traces but not metrics, which otherwise logs an export error every
# interval. Default 15000ms between exports.
OTEL_METRICS_ENABLED=
OTEL_METRIC_EXPORT_INTERVAL_MS=

# Build provenance — the commit each service reports on /health, so "what is
# live" is answerable with one curl rather than an SSH and a `git rev-parse`.
# Read by all five services (shared/src/build.ts and the two Python
# build_info.py). Resolution order is BUILD_SHA, then BUILD_SHA_FILE, then
# `<repo root>/BUILD_SHA` — which is the file `infra/deploy.sh` writes, so a
# normal deploy needs neither of these set. BUILD_SHA is for containers and CI,
# where there is no repo checkout; BUILD_SHA_FILE is for a layout that puts the
# file somewhere other than the repo root. An unreadable or malformed value
# reports `unknown` rather than failing the health check.
BUILD_SHA=
BUILD_SHA_FILE=

# Internal service URLs (valuation → ai / engine-wrapper / report)
AI_URL=http://127.0.0.1:3002
ENGINE_URL=http://127.0.0.1:3003
# Where the 409A PDF is rendered. Set, the valuation service POSTs the document
# to the report unit instead of laying it out on its own event loop — a render
# is 400–700ms during which nothing else on the API is served. Every failure of
# that hop falls back to rendering in-process, so the worst case is the old
# behaviour; watch report_render_total{mode="local"} on /metrics to see whether
# the offload is actually happening. Set it empty to render in-process always.
REPORT_URL=http://127.0.0.1:3004
# Where the web service proxies API calls, and the directory it serves the
# built frontend from. Both have working defaults (the valuation service on
# 127.0.0.1:3001, and the web-frontend `dist` next door); set them when the
# services are not colocated, or when a package layout puts the build elsewhere.
VALUATION_URL=
WEB_STATIC_ROOT=
# Shared secret the valuation service sends as X-Internal-Token on every AI /
# engine / report call; those three services reject non-health requests without
# it (audit B-1 P0). Generate one: openssl rand -hex 32
#
# REQUIRED IN PRODUCTION. Leaving it blank is fine locally — the gate stays off
# — but a service told it is in production (NODE_ENV=production for report,
# APP_ENV=production for ai and engine-wrapper) refuses to start without it,
# rather than serving every internal route unauthenticated (R25 audit).
INTERNAL_SERVICE_TOKEN=

# Secret a Prometheus scraper presents to GET /metrics on the web, valuation and
# report services, as `Authorization: Bearer <token>` or `X-Internal-Token`.
#
# Optional, and falls back to INTERNAL_SERVICE_TOKEN when blank — so an estate
# that has one already needs nothing here. Set it when the scraper should hold a
# credential that is not the estate's service token: a Prometheus config file is
# read by more people and backed up in more places than a systemd unit.
#
# Blank AND no INTERNAL_SERVICE_TOKEN, in production, means the endpoint is not
# registered at all. That is deliberate — the web service is served straight
# through Caddy, so every path on it is public, and the scrape body names every
# route the platform has and how often each one fails.
METRICS_TOKEN=

# Per-caller request ceiling on the two Python services (requests per minute,
# per peer address). Leave unset for the built-in defaults — 1200 for the
# engine, 240 for the AI service, both far above any real workload. Set 0 to
# disable. Health and readiness probes are never counted.
RATE_LIMIT_RPM=

# Largest request body the two Python services accept, in bytes. Defaults are
# per service — 32 MiB on the AI service (a document arrives whole), 8 MiB on
# the engine. Unset or non-numeric keeps the default; so does 0.
MAX_REQUEST_BODY_BYTES=

# Longest one live market-data fetch may hold an engine thread, in seconds
# (default 15). yfinance passes no timeout of its own, so a black-holed socket
# at the data source would otherwise hold a sync handler's threadpool slot
# forever while the caller retries into new ones. Past the ceiling the feed
# answers with its documented fallback payload, the same as for any other
# market-data failure. Unset or non-numeric keeps the default; 0 disables the
# bound, which is for an operator running a deliberately slow local source.
MARKET_FEED_FETCH_TIMEOUT_S=

# Longest one multiples *request* may spend fetching, across every ticker it
# names, in seconds (default 30). The ceiling above bounds one fetch and the
# multiples fan-out makes one per ticker in sequence, up to fifty — so without
# this the request as a whole was still bounded only at 50 x 15s, well past the
# point the Node caller has given up and stopped reading. Tickers not reached
# inside the budget come back with a warning, like any other unavailable one.
# Unset or non-numeric keeps the default; 0 disables the bound.
MARKET_FEED_MULTIPLES_BUDGET_S=

# Largest response body the AI service will hold from an outbound call, in
# bytes (default 16 MiB). Every call it makes leaves the trust boundary — an
# LLM gateway, a keyless web index, a SearXNG at whatever URL is set below — and
# without a ceiling the size of the buffer is the far end's choice. Unset or
# non-numeric keeps the default; 0 disables the cap.
MAX_RESPONSE_BYTES=
# Sync-handler threadpool size on the Python services (default 40). The engine
# runs CPU-bound valuation maths off the event loop through this pool, so it is
# the knob for how many simultaneous calculations a box will attempt.
THREADPOOL_MAX=

# Whether the engine resolves its comparable-company universe from the live
# market feed or from the bundled snapshot. Unset means live wherever the feed
# is installed, so installing yfinance is the whole of enabling it. Set a falsey
# word (0 / false / no / off / none / disabled) to pin the snapshot — which is
# what a deployment that needs byte-identical reruns of a past period wants.
ENGINE_LIVE_UNIVERSE=

# ── Postgres connection pool ─────────────────────────────────────────────────
# Tuning for the valuation service's pool (db/pool.ts). Every one has a
# production-safe default, so an ordinary deployment sets none of them; they are
# here because a pool knob nobody can find is a pool knob nobody turns during
# the incident it exists for. A blank or unparseable value falls back to the
# default rather than to zero.
#
# DB_POOL_MAX is the one to reach for first: 10 connections per service process
# against a Postgres whose own max_connections is shared with the migrations,
# the backup rehearsal and psql.
DB_POOL_MAX=
# Milliseconds. A statement past DB_STATEMENT_TIMEOUT_MS is cancelled by
# Postgres rather than held open; DB_IDLE_TX_TIMEOUT_MS does the same for a
# transaction left open between statements, which is what holds locks.
DB_STATEMENT_TIMEOUT_MS=
DB_IDLE_TX_TIMEOUT_MS=
# The migration runner borrows a client from that same pool but overrides both
# bounds for the length of each migration's transaction, because DDL wants the
# opposite of what a request handler wants.
#
# MIGRATION_STATEMENT_TIMEOUT_MS (default 300000) has to be *higher*: the 15s
# request ceiling cancels any index build over a table large enough to take it,
# which passes on an empty CI database and fails the boot in production.
#
# MIGRATION_DDL_LOCK_TIMEOUT_MS (default 3000) has to exist at all: Postgres
# defaults lock_timeout to 0, and an ALTER TABLE queued behind one long reader
# blocks every request to that table that arrives after it. Raising this makes
# that queue longer, not shorter — find the lock holder instead.
MIGRATION_STATEMENT_TIMEOUT_MS=
MIGRATION_DDL_LOCK_TIMEOUT_MS=
# Milliseconds to wait for a connection from the pool, and how long an unused
# one is kept before it is closed.
DB_CONNECTION_TIMEOUT_MS=
DB_IDLE_TIMEOUT_MS=
# TLS to the database. Unset infers it from the connection string's `sslmode`
# and defaults to on in production, so a plaintext production database is a
# deliberate opt-out rather than a silent default. `disable`/`false`/`off` turns
# it off; `no-verify` keeps the encryption but stops verifying the chain, which
# is what a managed Postgres with a self-signed certificate needs;
# `require`/`true`/`on` demands it.
DB_SSL=

# ── The proxy chain in front of the services ─────────────────────────────────
# Which hops may set X-Forwarded-For, as a comma-separated list of CIDRs or the
# named shorthands Fastify understands (`loopback`, `linklocal`, `uniquelocal`)
# plus this platform's own `cloudflare`, which expands to the published edge
# ranges. Unset means `loopback, linklocal, uniquelocal`.
#
# It has to name every hop, and the deployed chain is
# `client → Cloudflare edge → Caddy → web`: with the edge left out, the address
# every per-IP rate limit and audit row is keyed on is Caddy's, so one client's
# throttle is shared by all of them. Set `TRUSTED_PROXIES=none` for a service
# exposed directly, where the socket peer *is* the client. Asking for blanket
# trust (`true`, `*`, `0.0.0.0/0`) is refused at boot rather than accepted: it
# would make that identity client-controlled.
TRUSTED_PROXIES=

# Where uploaded document blobs are written. Relative paths resolve against the
# valuation service's working directory, which on the deployed units is
# /opt/N409 — set an absolute path if that is not what you want.
DOCUMENTS_DIR=./data/documents

# Where infra/backup/pg-backup.sh writes its dumps. The valuation service reads
# this directory — never writes it — to publish n409_backup_age_seconds and
# n409_backup_count, which is what turns "the nightly dump has not run for a
# fortnight" from a line in a journal nobody reads into an alert (R428). Must
# match the BACKUP_ROOT the two backup units set. Empty switches the gauges off
# and reports n409_backup_watched 0.
BACKUP_ROOT=/opt/n409-backups

# Where infra/backup/pg-verify.sh stamps the result of the weekly restore
# rehearsal. The valuation service reads it — never writes it — to publish
# n409_backup_verify_last_success_seconds and n409_backup_verify_failed, which
# is what turns "did the last restore actually work" from a line in a journal
# into an alert (R437). It cannot share BACKUP_ROOT: n409-backup-verify.service
# mounts that path read-only by design. Must match the unit's StateDirectory=.
# Empty switches the gauges off and reports n409_backup_verify_watched 0.
BACKUP_VERIFY_STATE_DIR=/var/lib/n409-backup-verify

# ── At-rest encryption keys (AES-256-GCM) ────────────────────────────────────
# Three subsystems seal something at rest with the same envelope: uploaded
# document blobs, TOTP seeds, and the OAuth tokens and webhook secrets that
# belong to a client's accounting/HRIS/cap-table provider. Each key is 32 bytes
# as 64 hex chars or base64 — generate with `openssl rand -hex 32`.
#
# The three names are a fallback chain, most specific first, so one key is a
# legitimate deployment: CONNECTION_ENCRYPTION_KEY → MFA_ENCRYPTION_KEY →
# DOCUMENTS_ENCRYPTION_KEY for integration credentials, MFA_ENCRYPTION_KEY →
# DOCUMENTS_ENCRYPTION_KEY for TOTP seeds, DOCUMENTS_ENCRYPTION_KEY for blobs.
# Unset means blobs and integration credentials are stored in the clear, and
# writing a TOTP seed is refused outright in production.
DOCUMENTS_ENCRYPTION_KEY=
MFA_ENCRYPTION_KEY=
CONNECTION_ENCRYPTION_KEY=

# Rotation. Each key accepts a retired predecessor, honoured on *read* only, so
# turning over a key does not make everything sealed under the old one
# permanently unreadable — GCM authenticates, so a value sealed under a retired
# key throws rather than decoding to garbage, which without this makes a
# rotation indistinguishable from data loss. Set the `_PREVIOUS` name to the old
# key, run `tools/rotate-at-rest-keys.mjs` to re-seal the backlog, then delete
# it. See infra/DEPLOYMENT.md for the four steps.
DOCUMENTS_ENCRYPTION_KEY_PREVIOUS=
MFA_ENCRYPTION_KEY_PREVIOUS=
CONNECTION_ENCRYPTION_KEY_PREVIOUS=

# Auto-pipeline on upload (extraction → param fill → draft calculation).
# `off` disables it for the whole installation; a single engagement opts out
# through valuations.auto_pipeline instead. MAX_CONCURRENT bounds how many run
# at once — excess uploads keep a 'queued' run row until a slot frees, they are
# not dropped. STALE_MINUTES is the reaper that fails a run left active by a
# restart; 0 disables the sweep and orphaned runs then sit forever.
AUTO_PIPELINE=on
AUTO_PIPELINE_MAX_CONCURRENT=4
AUTO_PIPELINE_STALE_MINUTES=30

# Email delivery. EMAIL_MODE is smtp | log | off — there is no `sendgrid` mode;
# SendGrid is just an SMTP relay (host smtp.sendgrid.net, user the literal
# `apikey`, pass the SG.… key). `smtp` with SMTP_HOST unset falls back to the
# log transport, which is right locally and is a refuse-to-boot error in
# production — every message would be recorded delivered and written to stdout.
# SMTP_FROM must be a sender identity verified with the provider, or sends fail
# at delivery time.
EMAIL_MODE=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Shared secret for the provider's delivery-event webhook (bounces, complaints).
# Unset — the default, and what this deployment runs — means the route is not
# registered at all, which is the safe state rather than a missing feature: an
# endpoint taking unsigned delivery claims lets anyone mark a named client's
# address as bounced, and a bounced address is suppressed. That is a denial of
# service against one client, from the internet, with no account behind it.
# Bounce tracking does not depend on this; a relay that rejects a recipient
# in-band is classified with no provider callback involved. At least 32 chars.
EMAIL_WEBHOOK_SECRET=

# SMS drip campaigns (§15.6) — `log` records delivery in the service log, `off`
# only queues the outbox row. There is no provider mode yet; an adapter slots
# into buildEmailTransports when there is one.
SMS_MODE=log

# Background sweeps, all in minutes, all disabled by 0 — each has an admin
# endpoint that still works when the interval is off, which is how a deployment
# that drives these from cron turns them off.
#   AUTO_EMAIL   drip-campaign scan            POST /admin/auto-emails/run
#   EMAIL_RETRY  re-sends outbox rows a transient transport error left 'failed';
#                rows that have failed MAX_ATTEMPTS times are left alone, being
#                a real failure rather than a hiccup. Nothing else revisits them.
#   WEBHOOK      partner webhook delivery retries (migration 0103)
#   JOB_ALERT    job-queue alerting            POST /admin/jobs/alerts/scan
AUTO_EMAIL_SCAN_MINUTES=15
EMAIL_RETRY_SCAN_MINUTES=30
EMAIL_RETRY_MAX_ATTEMPTS=5
WEBHOOK_RETRY_SCAN_MINUTES=1
JOB_ALERT_SCAN_MINUTES=5

# Base URL used to build emailed links (password reset, board signature) and
# Stripe checkout returns. Must be the public origin, not localhost, in prod.
PUBLIC_BASE_URL=

# Stripe (remaining-gaps §3 #1). The payment routes answer 503 while the secret
# key is unset, so an installation that does not sell anything needs none of it.
#
# The two below are a set. Checkout is offered on STRIPE_SECRET_KEY alone, and
# the webhook is the only thing that marks a payment succeeded and releases the
# engagement — so a production deployment with the key and no webhook secret
# charges clients and fulfils nothing, and refuses to boot for that reason. The
# reverse (webhook secret, no key) is safe: checkout is unavailable and the
# invoice fallback takes over.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# There are TWO webhook endpoints — payments at /api/v1/stripe/webhook and
# subscriptions/invoices at /api/v1/billing/webhook — and Stripe issues a
# separate signing secret per registered endpoint. It cannot be told to reuse
# one. So if both endpoints are registered and only STRIPE_WEBHOOK_SECRET is
# set, every delivery to the other one is answered `400 Invalid Stripe
# signature`, and the only place that surfaces is Stripe's own failed-delivery
# list. The events being silently dropped are the ones recording a subscription
# starting and an invoice being paid.
#
# Set this to the billing endpoint's own signing secret. Left unset it falls
# back to STRIPE_WEBHOOK_SECRET, so registering a single endpoint — or not
# enabling subscriptions at all — needs no extra configuration.
STRIPE_BILLING_WEBHOOK_SECRET=

# The domain white-label tenants live under, e.g. 'app.409.ai' — a request for
# acme.app.409.ai then resolves the partner with subdomain 'acme' (migration
# 0106). Unset disables host-based tenant resolution entirely, which is the
# right default: without a known base domain, any Host header a client sent
# would be read as a tenant claim.
APP_BASE_DOMAIN=

# Per-user / per-org request throttling across the whole authenticated API
# surface (on top of the existing per-endpoint auth/partner-API limiters).
# Only enforced when NODE_ENV=production. 0 disables either one. Defaults
# (300/user, 1500/org per minute) are generous for normal UI/API use.
SESSION_RATE_LIMIT_PER_MIN=
SESSION_RATE_LIMIT_ORG_PER_MIN=

# The partner API's own per-organisation ceiling, charged across every API key
# an organisation holds (default 600/min; 0 disables). This is what makes the
# per-key limit of 120/min a bound on a caller rather than on a key: minting
# keys is self-service and uncapped, so without it an organisation's budget was
# 120 times however many keys it chose to create. Enforced in every environment,
# unlike the two counters above.
PARTNER_API_RATE_LIMIT_ORG_PER_MIN=

# Per-user budget, in cost units per minute, for expensive routes: PDF/XLSX
# renders, evidence bundles, engine calculations and AI pipelines (costs live
# in src/domain/requestCost.ts). Charged on top of the request counters above,
# because one render costs as much as thirty list calls. Only enforced when
# NODE_ENV=production; 0 disables. The default (200) allows roughly 20 report
# renders, 8 evidence bundles or 8 AI jobs a minute.
HEAVY_RATE_LIMIT_PER_MIN=

# Partner webhooks: a partner chooses the delivery URL and this service fetches
# it, so a target inside the network is an SSRF primitive — the delivery log
# even hands the response status back to them. Registration refuses loopback,
# RFC1918, link-local (169.254.169.254 is the cloud metadata endpoint) and
# `.internal`/`.local` names, delivery re-checks the *resolved* address, and
# redirects are never followed. Set `true` only in local development, where the
# receiver really is on 127.0.0.1. Unset means off, which is the safe default.
WEBHOOK_ALLOW_PRIVATE_TARGETS=

# Antivirus for uploaded documents (src/documents/virusScan.ts). File-type
# sniffing already refuses bytes that contradict the extension, but a
# weaponised XLSX is a *valid* XLSX — it sniffs clean, gets stored, and is
# handed to whoever downloads it next, which on this platform is an auditor or
# a board member opening a spreadsheet from a company they do not know.
#
# Unset means no scanning, which is the status quo and the safe default for
# boot: a scan nobody has deployed clamd for must not stop the service
# starting. Set CLAMAV_HOST to a clamd instance to turn it on; the port
# defaults to clamd's own 3310 and the per-scan timeout to 30000ms.
CLAMAV_HOST=
CLAMAV_PORT=
CLAMAV_TIMEOUT_MS=

# What an unreachable scanner means once one *is* configured. Fail-closed by
# default ('true'): a control that silently stops working is worse than no
# control, because the uploads that arrive while it is down are exactly the
# ones nobody will go back and re-check. Set 'false' where upload availability
# outranks the scan. No effect while CLAMAV_HOST is unset.
VIRUS_SCAN_FAIL_CLOSED=

# A statement at or over this many ms gets its own `slow query` warn line
# (src/db/queryStats.ts). The default 200 sits well under the 15s
# statement_timeout and above where a healthy indexed query on this schema
# lands, so the log names regressions rather than narrating normal traffic.
# 0 logs every statement. The aggregate at /api/v1/admin/db/slow-queries
# counts everything regardless — this threshold governs only the per-statement
# log line.
DB_SLOW_QUERY_MS=

# How often the pool-health sampler runs, in seconds (src/db/poolHealth.ts).
# The sample is a synchronous scan of a map bounded by the pool's max, so it is
# cheap enough to run often — and both conditions it looks for (a connection
# checked out and never returned, a pool that is fully saturated with callers
# queued) get worse the longer they go unreported. 0 disables the sampler; the
# gauges it feeds keep working either way. Default 15.
DB_POOL_SAMPLE_SECONDS=

# A connection checked out for longer than this many ms is reported as a
# suspected leak, with the stack that acquired it. Comfortably above the 15s
# statement_timeout on purpose: a long transaction running several statements is
# not a leak, and a detector that cries wolf is a detector somebody turns off.
# Default 60000.
DB_LEAK_AFTER_MS=

# How long the pool must be *continuously* saturated — every client checked out,
# nothing idle, callers queued — before it is reported exhausted, in ms. The
# dwell time is what separates a saturated pool from a merely busy one: at any
# given instant a healthy service under load has callers waiting. Default 5000.
DB_EXHAUSTED_AFTER_MS=

# Wall-clock budget, in ms, for the boot-time dependency probes
# (packages/shared/src/startup.ts). Postgres is required and is waited for on a
# jittered ladder; the AI and engine services are probed once and reported, but
# never block the boot — refusing to start because a model provider is down
# would turn a degraded feature into a total outage. Long enough to cover a
# database still starting after a host reboot, short enough that a genuinely
# absent one fails the unit while systemd still has restarts left. Default 60000.
STARTUP_DEPENDENCY_TIMEOUT_MS=

# How often failed auto-pipeline runs whose retry is due are re-queued, in
# minutes (migration 0161). A run that failed against a transient fault — the AI
# service restarting, an exhausted free-tier quota — carries a next_attempt_at
# on the jittered ladder in src/domain/pipelineRetry.ts; this sweep is what
# reads it. 0 disables the sweep, which leaves a transiently-failed run needing
# a manual trigger. Default 5.
PIPELINE_RETRY_SCAN_MINUTES=

# AI (later milestones) — OpenRouter, free-tier models. Verified at boot and on
# /ready: the key must start with `sk-or-` and be accepted by OpenRouter's key
# endpoint, otherwise the service logs an error and /ready reports 503.
OPENROUTER_API_KEY=
# Set to 1 to make a failed key check abort startup instead of degrading
# (systemd then crash-loops rather than serving a key-less AI service).
AI_REQUIRE_OPENROUTER_KEY=
# Pin one model for every OpenRouter call, overriding the per-topic model in
# ai_prompts.model and the built-in chain. Mostly a debugging tool: free model
# ids go stale and start 404ing, and pinning is how you confirm that is what
# happened. Unset is normal.
OPENROUTER_MODEL=
# Per-call output ceiling, and the wall clock for one chat call (0 disables the
# clock). Both have built-in defaults.
OPENROUTER_MAX_TOKENS=
OPENROUTER_CALL_BUDGET_S=
# Total tokens this process will spend before refusing further calls. Guards a
# runaway loop once a paid key is configured; 0 or unset means unlimited. It is
# counted in-process rather than cluster-wide — a coarse safety net, not billing.
OPENROUTER_TOKEN_BUDGET=

# AWS Bedrock, an alternative LLM backend to OpenRouter. Activates only when
# region and credentials are all present; unset means the service does not
# consider it at all. SESSION_TOKEN is needed only for temporary (STS)
# credentials. BEDROCK_MODEL defaults to anthropic.claude-sonnet-4-20250514-v1:0.
BEDROCK_REGION=
BEDROCK_MODEL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Per-call ceilings on the Bedrock path, mirroring the OpenRouter ones above.
# Defaults: 2000 output tokens, 150s of wall clock (0 disables the budget).
BEDROCK_MAX_TOKENS=
BEDROCK_CALL_BUDGET_S=
# Process-lifetime token ceiling for Bedrock; unset/0 means unlimited. The twin
# of OPENROUTER_TOKEN_BUDGET, and the one that matters more: every Bedrock call
# is billed to the AWS account above, so a runaway loop here spends real money.
BEDROCK_TOKEN_BUDGET=

# Web-grounded research with citations (/ai/v1/research). Two providers, tried
# in order, so the feature works with or without a paid account:
#
#   1. Perplexity Sonar — PRIMARY, used whenever PERPLEXITY_API_KEY is set. One
#      billed call that searches a real index and writes a sourced answer. The
#      better result, and the reason the fallback stays a fallback.
#   2. Search + synthesis — automatic FALLBACK. Used when no Perplexity key is
#      set, and when a Sonar call fails for any reason (rejected key, exhausted
#      quota, outage, unparseable body). A search provider retrieves the sources
#      and the OpenRouter models above write the answer up from them.
#
# The fallback is silent to the caller — same response shape either way, with
# `model` naming the path that answered. Neither is part of readiness: every
# pipeline works without research, so a lapsed key must not take the valuation
# path down. /ready reports `research_primary` (only when keyed) and `search`.
#
# NOTE this path issues live web searches, so unlike OPENROUTER_API_KEY it is
# never handed client documents — see src/services/ai/app/research.py, which
# refuses any query bearing the redactor's placeholders BEFORE choosing a
# provider, and never falls back after such a refusal.

# --- 1. Perplexity (primary) -------------------------------------------------
# Unset today: Perplexity sells no free tier. Leaving it blank is supported and
# is the documented default — the fallback below answers instead. Keys start
# 'pplx-'; a key that does not is rejected without spending a round trip.
PERPLEXITY_API_KEY=
# Sonar tier: sonar (default) | sonar-pro | sonar-reasoning. Each is billed.
# The per-topic tier lives in ai_prompts.model (migrations 0117/0124); this is
# only the default for calls that name none.
PERPLEXITY_MODEL=
# Per-call output ceiling and whole-call wall clock (0 disables the clock).
PERPLEXITY_MAX_TOKENS=
PERPLEXITY_CALL_BUDGET_S=
# Process-lifetime token ceiling for Sonar; unset/0 means unlimited. The third
# of these, and the same argument as BEDROCK_TOKEN_BUDGET above: every Sonar
# call is billed to the account behind the key, so a loop through
# /ai/v1/research spends real money and this is the only thing that stops it.
PERPLEXITY_TOKEN_BUDGET=

# --- 2. Search + synthesis (fallback) ----------------------------------------
#   duckduckgo (default)  no key, no account. Scrapes the lite endpoint, which
#                         DuckDuckGo defends with an anti-bot challenge that
#                         trips after a modest number of queries from one
#                         address. Right for a fresh checkout and for an
#                         analyst asking a handful of questions; wrong for a
#                         busy installation. Being blocked is reported plainly
#                         on /ready — it is never worked around.
#   searxng               no key; needs SEARXNG_URL. Self-host for the only
#                         keyless option without a rate-limit cliff.
#   brave|serper|tavily   a free-tier key each (no card): 2k/mo, 2.5k once,
#                         1k/mo respectively.
#   wikipedia             no key, and keyless because MediaWiki intends it to
#                         be — a real public API, so nothing to be blocked by.
#                         Narrow (no transaction comps, no last quarter), which
#                         is why it is the chain's last stop rather than a
#                         default worth choosing.
RESEARCH_PROVIDER=
# This names where the search *starts*. When a backend cannot answer — no key,
# a challenge, a 429, an outage — the next configured one is tried, ending at a
# keyless backend, so one blocked provider costs index quality rather than the
# feature. Set to 0 to disable and use only RESEARCH_PROVIDER; the reason to do
# that is compliance (being able to say which index a citation came from),
# not performance.
RESEARCH_PROVIDER_CHAIN=
# How long a backend that answered with a bot challenge or a 429 is skipped
# before being tried again. Default 900 (15 minutes); 0 disables the bench.
# This is the deliberate response to being blocked: back off and ask elsewhere.
# The packaged alternative (`ddgs`, formerly `duckduckgo-search`) defeats the
# challenge with randomised browser fingerprints; this codebase does not, and
# a test asserts the package stays uninstalled.
RESEARCH_PROVIDER_COOLDOWN_S=
# Base URL of a SearXNG instance, e.g. https://searx.example.org — required
# when RESEARCH_PROVIDER=searxng. No default on purpose: pointing every install
# at a stranger's server would be both rude and unreliable.
SEARXNG_URL=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=
# How many sources to retrieve per question, and the whole-search wall clock
# (0 disables the clock). More sources is a better-grounded answer and a longer
# synthesis prompt.
RESEARCH_MAX_RESULTS=
RESEARCH_CALL_BUDGET_S=
# Pin the OpenRouter model that writes the fallback's answers up. Unset uses
# the same chain as the pipelines. A Sonar tier arriving from ai_prompts.model
# is ignored here rather than forwarded — it names the primary's tier.
RESEARCH_SYNTHESIS_MODEL=

# Force PII redaction on the AI service even when a caller passes
# options.anonymize=false (audit B-1 P1). Set APP_ENV=production on the ai
# service in prod, or ANONYMIZE_ENFORCE=1 explicitly.
APP_ENV=
ANONYMIZE_ENFORCE=

# Frontend SEO (409.ai §24) — canonical origin for sitemap/robots/OG/canonical
# tags. Read at web-frontend build time. SITE_URL wins where both are set;
# VITE_SITE_URL exists for build environments that only forward VITE_-prefixed
# variables. Baked into the build, so changing it needs a rebuild, not a restart.
SITE_URL=https://409.doaide.com
VITE_SITE_URL=

# Frontend web analytics (409.ai §23) — leave blank to disable. Baked into the
# web-frontend build; scripts load only after cookie consent (§25). Bare names
# below are also accepted as VITE_GTM_ID / VITE_GA4_ID / VITE_FB_PIXEL_ID.
GTM_ID=
GA4_ID=
FB_PIXEL_ID=

# Marketing surface (web-frontend src/lib/siteConfig.ts). Each of these is read
# at build time and each one that is blank omits its CTA, embed, or address
# rather than rendering a dead link — so an unset value is a quietly missing
# button on the public site, not an error. Same VITE_-prefixed forms accepted.
CALENDLY_URL=
DEMO_VIDEO_URL=
TWITTER_URL=
LINKEDIN_URL=
PARTNERS_EMAIL=
PRIVACY_EMAIL=
SUPPORT_EMAIL=

# Cap-table sync (feature 4) — Carta / Pulley OAuth
CARTA_CLIENT_ID=
CARTA_CLIENT_SECRET=
PULLEY_CLIENT_ID=
PULLEY_CLIENT_SECRET=

# HRIS/payroll for ASC 718 (feature 11) — Rippling / Gusto / Deel OAuth
RIPPLING_CLIENT_ID=
RIPPLING_CLIENT_SECRET=
GUSTO_CLIENT_ID=
GUSTO_CLIENT_SECRET=
DEEL_CLIENT_ID=
DEEL_CLIENT_SECRET=

# Accounting integrations (§23) — each provider activates only when BOTH its
# client id and secret are set, and shows as "not configured" otherwise. A half
# -filled pair is the same as none, so there is no partially-working state to
# debug.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
FRESHBOOKS_CLIENT_ID=
FRESHBOOKS_CLIENT_SECRET=
NETSUITE_CLIENT_ID=
NETSUITE_CLIENT_SECRET=
SAGE_CLIENT_ID=
SAGE_CLIENT_SECRET=
WAVE_CLIENT_ID=
WAVE_CLIENT_SECRET=

# ── Feature flags ────────────────────────────────────────────────────────────
#
# Kill switches for machinery that is already running, declared in
# src/packages/shared/src/flags.ts. Read per call, so a change takes effect on a
# `systemctl restart` with no rebuild and no deploy.
#
# Every one of these defaults to ON when unset, which is deliberate: they gate
# behaviour that is live in production today, so an unset variable — the state
# of every freshly provisioned host — has to mean "keep doing what we do now".
# Setting one is how an operator *departs* from the shipped behaviour, normally
# to shorten an incident that a revert-and-redeploy would otherwise own.
#
# Accepted: 1/true/yes/on/enabled and 0/false/no/off/disabled, any case.
# Anything else is refused by the deploy preflight rather than guessed at.

# Circuit breakers on the internal engine/AI clients (clients/internal.ts).
# Off: every call is dialled, with no memory of recent failures. Throw this when
# a breaker has opened against an upstream that is actually healthy — the
# platform then reports features unavailable that would have worked, and waiting
# does not fix it, because the probe traffic is what is being refused.
FLAG_CIRCUIT_BREAKERS=

# Automatic retries: the in-request ladder in the internal clients, and the
# persisted sweeps behind the email outbox (0159), partner webhooks (0103) and
# pipeline runs (0161). Off: a transient failure is reported rather than
# re-attempted, and the sweeps claim nothing — so queued work keeps its attempt
# counters and its schedule, and resumes when this goes back on. Throw this when
# a ladder is multiplying load on a dependency that is failing slowly.
FLAG_RETRY_LADDERS=

# The weekly restore-test of the Postgres dump (infra/backup/pg-verify.sh).
# Off: dumps are still taken — n409-backup.timer is untouched — but never proven
# restorable, and the unit exits 0 with a SKIPPED line. Throw this only for a
# host short of disk or IO, and put it back promptly: what it buys while off is
# a backup nobody has tested.
FLAG_BACKUP_VERIFICATION=
