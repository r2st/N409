{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "n409-web",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "src/services/web/dist/index.js"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "n409-valuation",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "JWT_SECRET=dev-only-secret-change-me-0123456789abcdef",
        "node",
        "src/services/valuation/dist/index.js"
      ],
      "port": 3001
    },
    {
      "name": "n409-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@n409/web-frontend",
        "--",
        "--port",
        "5199",
        "--strictPort"
      ],
      "port": 5199,
      "env": {
        "VALUATION_URL": "http://127.0.0.1:3021"
      }
    }
  ]
}