    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.1",
    "@n409/shared": "*",
    "fastify": "^5.12.1",
    "fontkit": "^2.0.4",
    "pdfkit": "^0.20.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/fontkit": "^2.0.9",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.23.12",
    "vitest": "^3.0.0"
  }
